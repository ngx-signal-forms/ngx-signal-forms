{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{workspaceRoot}/oxlint.config.ts",
      "!{workspaceRoot}/.oxfmtrc.json",
      "!{projectRoot}/vitest*.{js,cjs,mjs,ts,cts,mts}",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/tsconfig.spec.*.json",
      "!{projectRoot}/**/test-setup*.{js,cjs,mjs,ts,cts,mts}",
      "!{projectRoot}/api-reports/**",
      "!{projectRoot}/.size-limit.cjs",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs"
    ],
    "sharedGlobals": []
  },
  "nxCloudId": "6af4748bf10a963b9ec5c72c",
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["...", "^production", "{workspaceRoot}/oxlint.config.ts"]
    },
    "test": {
      "cache": true,
      "inputs": [
        "...",
        "default",
        "^production",
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.mjs",
          "transitive": true
        }
      ]
    },
    "test-browser": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "env": "CI"
        },
        {
          "env": "PLAYWRIGHT_BROWSER_CHANNEL"
        }
      ],
      "outputs": ["{projectRoot}/.vitest/report-browser"]
    },
    "serve": {
      "continuous": true
    },
    "@nx/angular:package": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/angular:ng-packagr-lite": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "playwright",
      "linter": "none",
      "style": "css",
      "unitTestRunner": "vitest-analog"
    },
    "@nx/angular:library": {
      "linter": "none",
      "unitTestRunner": "vitest-analog"
    },
    "@nx/angular:component": {
      "style": "css"
    }
  },
  "release": {
    "projects": ["toolkit"],
    "version": {
      "git": {
        "commit": false,
        "tag": false
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": "github",
        "renderer": "{workspaceRoot}/tools/release/project-changelog-renderer.ts",
        "file": false,
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      }
    },
    "releaseTag": {
      "pattern": "v{version}",
      "strictPreid": true
    },
    "conventionalCommits": {
      "types": {
        "feat": {
          "semverBump": "minor",
          "changelog": {
            "title": "🚀 Features"
          }
        },
        "fix": {
          "semverBump": "patch",
          "changelog": {
            "title": "🩹 Bug Fixes"
          }
        },
        "perf": {
          "semverBump": "patch",
          "changelog": {
            "title": "⚡ Performance"
          }
        },
        "refactor": {
          "semverBump": "none",
          "changelog": {
            "title": "♻️ Refactoring"
          }
        },
        "docs": {
          "semverBump": "none",
          "changelog": {
            "title": "📚 Documentation"
          }
        },
        "test": {
          "semverBump": "none",
          "changelog": false
        },
        "build": {
          "semverBump": "none",
          "changelog": false
        },
        "ci": {
          "semverBump": "none",
          "changelog": false
        },
        "chore": {
          "semverBump": "none",
          "changelog": false
        }
      }
    }
  },
  "analytics": false,
  "migrate": {
    "agentic": true
  },
  "plugins": [
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      },
      "include": [
        "apps/demo/**/*",
        "apps/demo-material/**/*",
        "apps/demo-primeng/**/*",
        "apps/demo-spartan/**/*",
        "packages/demo/debugger/**/*",
        "packages/demo/shared/**/*"
      ]
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ]
}
