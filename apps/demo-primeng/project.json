{
  "name": "demo-primeng",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ngx",
  "sourceRoot": "apps/demo-primeng/src",
  "tags": ["scope:demo", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/demo-primeng"],
      "defaultConfiguration": "production",
      "options": {
        "cwd": "apps/demo-primeng"
      },
      "configurations": {
        "production": {
          "command": "vite build --mode production"
        },
        "development": {
          "command": "vite build --mode development"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "readyWhen": {
        "url": "http://127.0.0.1:{options.port}",
        "timeout": 240000
      },
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/demo-primeng"
      },
      "configurations": {
        "production": {
          "command": "vite preview --strictPort",
          "port": 4720
        },
        "development": {
          "command": "vite --strictPort",
          "port": 4620
        }
      }
    },
    "test": {
      "options": {
        "config": "./vitest.config.mts"
      }
    }
  }
}
