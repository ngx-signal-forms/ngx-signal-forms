{
  "name": "demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ngx",
  "sourceRoot": "apps/demo/src",
  "tags": ["scope:demo", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/demo"],
      "defaultConfiguration": "production",
      "options": {
        "cwd": "apps/demo"
      },
      "configurations": {
        "production": {
          "command": "vite build --mode production"
        },
        "development": {
          "command": "vite build --mode development"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "readyWhen": {
        "url": "http://127.0.0.1:{options.port}",
        "timeout": 240000
      },
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/demo"
      },
      "configurations": {
        "production": {
          "command": "vite preview --strictPort",
          "port": 4700
        },
        "development": {
          "command": "vite --strictPort",
          "port": 4600
        }
      }
    },
    "serve-e2e": {
      "executor": "nx:run-commands",
      "continuous": true,
      "readyWhen": {
        "logMatches": "Local:",
        "timeout": 240000
      },
      "options": {
        "command": "vite --host 127.0.0.1 --strictPort",
        "cwd": "apps/demo"
      }
    },
    "test": {
      "options": {
        "config": "./vitest.config.mts"
      }
    },
    "test-timezones": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", { "env": "CI" }],
      "options": {
        "cwd": "apps/demo",
        "commands": [
          "TZ=Pacific/Auckland vitest run src/app/05-advanced",
          "TZ=America/New_York vitest run src/app/05-advanced"
        ],
        "parallel": false
      }
    }
  }
}
