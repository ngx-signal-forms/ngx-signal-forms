{
  "name": "demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ngx",
  "sourceRoot": "apps/demo/src",
  "tags": ["scope:demo", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/demo"],
      "defaultConfiguration": "production",
      "options": {
        "cwd": "apps/demo"
      },
      "configurations": {
        "production": {
          "command": "vite build --mode production"
        },
        "development": {
          "command": "vite build --mode development"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/demo"
      },
      "configurations": {
        "production": {
          "command": "vite preview --port 4700 --strictPort"
        },
        "development": {
          "command": "vite --port 4600 --strictPort"
        }
      }
    },
    "test": {
      "options": {
        "config": "./vitest.config.mts"
      }
    },
    "test-timezones": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "apps/demo",
        "commands": [
          "TZ=Pacific/Auckland vitest run src/app/05-advanced",
          "TZ=America/New_York vitest run src/app/05-advanced"
        ],
        "parallel": false
      }
    }
  }
}
