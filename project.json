{
  "name": "workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "check-skill-package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/scripts/check-skill-package.spec.mjs && node tools/scripts/check-skill-package.mjs"
      }
    },
    "check-changelog-renderer": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test tools/release/project-changelog-renderer.spec.mjs"
      }
    },
    "check-no-bare-mention": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/commitlint/no-bare-mention.spec.mjs"
      }
    },
    "check-docs7-site": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/scripts/build-docs7-site.spec.mjs && node tools/scripts/build-docs7-site.mjs"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint ."
      }
    },
    "lint-fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint . --fix --quiet"
      }
    },
    "lint-fix-suggestions": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint . --fix-suggestions --quiet"
      }
    },
    "lint-fix-dangerously": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint . --fix-dangerously --quiet"
      }
    },
    "lint-github": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint . --format=github"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxfmt ."
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxfmt . --check"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.coverage.config.mts --coverage --maxWorkers=2",
        "cwd": "{workspaceRoot}"
      }
    },
    "check-a11y-report-violations": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/scripts/a11y-report-violations.spec.mjs"
      }
    },
    "a11y-report": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/scripts/a11y-report-violations.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "a11y-report-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/scripts/a11y-report-violations.mjs --check",
        "cwd": "{workspaceRoot}"
      }
    },
    "a11y-baseline": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/scripts/a11y-report-violations.mjs --update-baseline",
        "cwd": "{workspaceRoot}"
      }
    },
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    }
  }
}
