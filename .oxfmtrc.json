{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "sortTailwindcss": {},
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    // Committed baseline snapshots of built `.d.ts` output (#514). These
    // must stay byte-identical to what ng-packagr emits, so the API-surface
    // guard's diff is meaningful; reformatting them would fight every build.
    "packages/toolkit/api-reports/**",
    // Vendored skills must stay byte-identical to their upstream source
    // (`skills-lock.json` hashes, `nx configure-ai-agents`). Do not format
    // them. Repo-owned skills (`ngx-signal-forms`, `ngrx-*`) are formatted.
    ".agents/skills/accessibility-a11y/**",
    ".agents/skills/angular-developer/**",
    ".agents/skills/link-workspace-packages/**",
    ".agents/skills/monitor-ci/**",
    ".agents/skills/nx-*/**",
    ".nx/cache/**",
    ".nx/workspace-data/**",
    ".angular/**",
    "apps/demo/public/mockServiceWorker.js",
    "apps/demo/src/app/01-getting-started/your-first-form/your-first-form.form.ts",
    "apps/demo/src/app/00-signal-forms-only/pure-signal-form/pure-signal-form.form.ts"
  ]
}
