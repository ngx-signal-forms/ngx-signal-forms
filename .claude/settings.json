{
  "env": {
    "NG_CLI_ANALYTICS": "false"
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["/tmp/.nx", "~/.nx"],
      "allowWrite": ["/tmp/.nx", "~/.nx"]
    },
    "network": {
      "allowUnixSockets": ["/tmp/.nx", "~/.nx"]
    }
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": false
  }
}
