{
  "name": "ui-helm",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/demo/spartan-ui/src",
  "prefix": "hlm",
  "tags": ["npm:private", "scope:demo", "type:lib"],
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/demo/spartan-ui/ng-package.json",
        "tsConfig": "packages/demo/spartan-ui/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/demo/spartan-ui/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    }
  }
}
