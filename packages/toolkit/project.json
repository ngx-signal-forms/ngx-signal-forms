{
  "name": "toolkit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/toolkit",
  "prefix": "sft",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:lib", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/toolkit/ng-package.json",
        "tsConfig": "packages/toolkit/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/toolkit/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "post-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "mkdir -p dist/packages/toolkit",
          "cp README.md dist/packages/toolkit/README.md",
          "cp LICENSE dist/packages/toolkit/LICENSE",
          "node packages/toolkit/scripts/strip-internal-members.mjs",
          "node packages/toolkit/scripts/strip-internal-exports.mjs"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "nx-release-publish": {
      "dependsOn": ["build", "post-build"],
      "options": {
        "packageRoot": "dist/{projectRoot}",
        "args": ["--json"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.jsdom.config.mts",
        "cwd": "packages/toolkit"
      }
    },
    "test-browser": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.browser.config.mts",
        "cwd": "packages/toolkit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint {projectRoot} --type-aware"
      }
    }
  }
}
