{
  "name": "toolkit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/toolkit",
  "prefix": "sft",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:lib", "type:lib"],
  "targets": {
    "build-ng-packagr": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/toolkit-ng-packagr"],
      "options": {
        "project": "packages/toolkit/ng-package.json",
        "tsConfig": "packages/toolkit/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/toolkit/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-ng-packagr"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/LICENSE",
        "{workspaceRoot}/README.md"
      ],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "commands": [
          "rm -rf dist/packages/toolkit",
          "cp -R dist/packages/toolkit-ng-packagr dist/packages/toolkit",
          "node packages/toolkit/scripts/generate-readme.mjs",
          "cp LICENSE dist/packages/toolkit/LICENSE",
          "node packages/toolkit/scripts/strip-internal-members.mjs",
          "node packages/toolkit/scripts/strip-internal-exports.mjs"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "check-documentation-starter": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node tools/scripts/check-documentation-starter.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "check-published-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node packages/toolkit/scripts/check-published-package.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "check-package-shape": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "pnpm exec publint dist/packages/toolkit --strict",
          "pnpm exec attw --pack dist/packages/toolkit --profile esm-only"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "check-size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node packages/toolkit/scripts/size-report.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "dist/{projectRoot}",
        "args": ["--json"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.jsdom.config.mts",
        "cwd": "packages/toolkit"
      }
    },
    "test-browser": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.browser.config.mts",
        "cwd": "packages/toolkit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint {projectRoot} --type-aware"
      }
    }
  }
}
