{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    // Match `tsconfig.lib.json`. The toolkit narrows validation errors
    // structurally rather than nominally (see docs/agents/domain-invariants.md),
    // so a mock whose shape drifts from the real Angular type is the exact
    // way a spec passes against a shape Angular never emits. Holding the
    // specs to the same strictness as the code they verify is what stops
    // that. See #286.
    // `scripts/*.spec.ts` uses `Array#toSorted` (Node 20+) and imports the
    // `.mjs` release scripts. `allowJs` lets their JSDoc supply the types,
    // without checking the scripts themselves (`checkJs` stays off).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest",
      "@vitest/browser-playwright"
    ]
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "./**/*.test.ts",
    "./**/*.spec.ts",
    "./**/*.test.tsx",
    "./**/*.spec.tsx",
    "./**/*.test.js",
    "./**/*.spec.js",
    "./**/*.test.jsx",
    "./**/*.spec.jsx",
    "./**/*.d.ts"
  ],
  "exclude": [
    // Committed baseline snapshots of built `.d.ts` output (#514) — raw
    // build output, not source; `./**/*.d.ts` above would otherwise pull
    // them into the spec program.
    "./api-reports/**"
  ],
  "files": ["test-setup.ts", "test-setup.browser.ts"]
}
