{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    // Match `tsconfig.lib.json`. The toolkit narrows validation errors
    // structurally rather than nominally (see the `CONTEXT.md` key concept),
    // so a mock whose shape drifts from the real Angular type is the exact
    // way a spec passes against a shape Angular never emits. Holding the
    // specs to the same strictness as the code they verify is what stops
    // that. See #286.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest",
      "@vitest/browser-playwright"
    ]
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "./**/*.test.ts",
    "./**/*.spec.ts",
    "./**/*.test.tsx",
    "./**/*.spec.tsx",
    "./**/*.test.js",
    "./**/*.spec.js",
    "./**/*.test.jsx",
    "./**/*.spec.jsx",
    "./**/*.d.ts"
  ],
  "files": ["test-setup.ts", "test-setup.browser.ts"]
}
