{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "exclude": [
    // Committed baseline snapshots of built `.d.ts` output (#514) — raw
    // build output, not source to compile.
    "./api-reports/**",
    "./**/*.spec.ts",
    "./core/utilities/testing/**",
    "./test-setup.ts",
    "jest.config.ts",
    "./**/*.test.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "./**/*.test.tsx",
    "./**/*.spec.tsx",
    "./**/*.test.js",
    "./**/*.spec.js",
    "./**/*.test.jsx",
    "./**/*.spec.jsx"
  ],
  "include": ["./**/*.ts"],
  "angularCompilerOptions": {
    // Angular merges `angularCompilerOptions` shallowly across `extends`: this
    // block replaces the one in `tsconfig.base.json`. Keep every base check
    // here, or the library build reports it as a warning only.
    "extendedDiagnostics": {
      "checks": {
        "controlFlowPreventingContentProjection": "error",
        "interpolatedSignalNotInvoked": "error",
        "invalidBananaInBox": "error",
        "missingControlFlowDirective": "error",
        "missingNgForOfLet": "error",
        "missingStructuralDirective": "error",
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress",
        "skipHydrationNotStatic": "error",
        "suffixNotSupported": "error",
        "textAttributeNotBinding": "error",
        "uninvokedFunctionInEventBinding": "error",
        "uninvokedTrackFunction": "error",
        "unparenthesizedNullishCoalescing": "error",
        "unusedLetDeclaration": "error",
        "unusedStandaloneImports": "error"
      }
    }
  }
}
